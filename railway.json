{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --no-frozen-lockfile && pnpm --filter @workspace/api-server run build"
  },
  "deploy": {
    "startCommand": "(pnpm --filter @workspace/db run push || echo '[railway] db push skipped') && node artifacts/api-server/dist/index.cjs",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 30
  }
}
